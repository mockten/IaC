# IaC Environment Configuration
#
# Copy this file to .env (gitignored) and fill in the values. The Taskfile
# exports them as TF_VAR_* for Terraform; CI supplies the same names from GitHub
# secrets. Nothing here is ever committed — every operator brings their own
# project, domain and IP.

# GitHub credentials for pulling images from ghcr.io
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_EMAIL=your_email@example.com

# OAuth credentials for Keycloak UAM (optional - leave blank to disable SSO).
# These are the DEV / local-k8s credentials, whose redirect URI is
#   http://localhost/realms/<realm>/broker/{google,facebook}/endpoint
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional: a SEPARATE OAuth app for cloud deployments, so a dev secret that
# leaks (it lives in every developer's .env) can't be used against the public
# deployment. If unset, the dev values above are reused.
#
# You do NOT need one of these per cloud: the redirect URI is derived from the
# domain, not the provider, so GCP/Azure/AWS sharing one domain share one URI:
#   https://${ROOT_DOMAIN}/realms/<realm>/broker/{google,facebook}/endpoint
# Register that URI (alongside the localhost one) on whichever app you use.
CLOUD_GOOGLE_CLIENT_ID=
CLOUD_GOOGLE_CLIENT_SECRET=
CLOUD_FACEBOOK_CLIENT_ID=
CLOUD_FACEBOOK_CLIENT_SECRET=

# Stripe: https://dashboard.stripe.com/test/apikeys
# The secret key is used by ecpay; the publishable key is served to the browser
# by ecfront at start-up. Both are needed for card payments to work.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# ── Cloud deployments (gcp/, and later azure/, aws/) ─────────────────────────

# GCP project to deploy into.
GCP_PROJECT=your-gcp-project-id

# The domain you own and will serve the platform on, no trailing dot.
# Subdomains sales./admin./dashboard. are derived from it automatically.
# Claim a free one at https://dash.domain.digitalplat.org if you need one.
# The same domain can be moved between clouds: destroy one, apply the next.
ROOT_DOMAIN=example.dpdns.org

# Registrar API token used to push the cloud's nameservers to the domain
# automatically (DigitalPlat: Dashboard -> API Keys -> Create API Key).
DOMAIN_API_KEY=

# The ONLY source IP allowed to reach the HTTPS ingress and the k8s control
# plane. Find yours with: curl https://api.ipify.org
ALLOWLIST_CIDR=203.0.113.10/32

# Email for Let's Encrypt certificate expiry notices.
LETSENCRYPT_EMAIL=your_email@example.com

# ── Azure (azure/) ───────────────────────────────────────────────────────────
# Only the credentials below are Azure-specific; everything above (GitHub, OAuth,
# Stripe, ROOT_DOMAIN, DOMAIN_API_KEY, ALLOWLIST_CIDR, LETSENCRYPT_EMAIL) is shared
# across clouds and reused as-is.
#
# Create a service principal scoped to your subscription, then map its output:
#   az login
#   SUB=$(az account show --query id -o tsv)
#   az ad sp create-for-rbac --name mockten-deployer --role Owner --scopes /subscriptions/$SUB
#   # appId -> ARM_CLIENT_ID, password -> ARM_CLIENT_SECRET, tenant -> ARM_TENANT_ID, $SUB -> ARM_SUBSCRIPTION_ID
# Portal: https://portal.azure.com (Subscriptions; Microsoft Entra ID -> App registrations)
#
# Remote state lives in Azure Storage (created once, not an env var):
#   az group create -n mockten-tfstate-rg -l eastus
#   az storage account create -n mocktentfstate -g mockten-tfstate-rg -l eastus --sku Standard_LRS
#   az storage container create -n tfstate --account-name mocktentfstate
# (storage-account names are globally unique; if taken, pick another and update
#  azure/providers.tf's backend `storage_account_name` to match.)
ARM_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_SECRET=your_service_principal_secret

# ── AWS (aws/) ───────────────────────────────────────────────────────────────
# Only the credentials below are AWS-specific; everything above (GitHub, OAuth,
# Stripe, ROOT_DOMAIN, DOMAIN_API_KEY, ALLOWLIST_CIDR, LETSENCRYPT_EMAIL) is shared
# across clouds and reused as-is.
#
# Create a deploy IAM user with programmatic access, then map its access key:
#   AccessKeyId -> AWS_ACCESS_KEY_ID, SecretAccessKey -> AWS_SECRET_ACCESS_KEY.
# Console: https://console.aws.amazon.com/iam (Users -> Create user -> Access keys)
# AWS_DEFAULT_REGION sets the provider/auth region; TF_VAR_region is the same value
# for the VPC/EKS/NAT resources (its var defaults to us-east-1, so set it explicitly).
# In CI these come from the AWS_REGION secret, mapped to both by the workflows.
#
# Remote state lives in S3 + a DynamoDB lock table (created once, not env vars):
#   aws s3api create-bucket --bucket mockten-tfstate-<account-id> --region ap-northeast-1 \
#     --create-bucket-configuration LocationConstraint=ap-northeast-1
#   aws dynamodb create-table --table-name mockten-tflock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST
# (the bucket name embeds your account id; update aws/providers.tf's backend to match.)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=ap-northeast-1
TF_VAR_region=ap-northeast-1
