# IaC Environment Configuration
#
# Copy this file to .env (gitignored) and fill in the values. The Taskfile
# exports them as TF_VAR_* for Terraform; CI supplies the same names from GitHub
# secrets. Nothing here is ever committed — every operator brings their own
# project, domain and IP.

# GitHub credentials for pulling images from ghcr.io
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_EMAIL=your_email@example.com

# OAuth credentials for Keycloak UAM (optional - leave blank to disable SSO).
# These are the DEV / local-k8s credentials, whose redirect URI is
#   http://localhost/realms/<realm>/broker/{google,facebook}/endpoint
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facebook: https://developers.facebook.com/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional: a SEPARATE OAuth app for cloud deployments, so a dev secret that
# leaks (it lives in every developer's .env) can't be used against the public
# deployment. If unset, the dev values above are reused.
#
# You do NOT need one of these per cloud: the redirect URI is derived from the
# domain, not the provider, so GCP/Azure/AWS sharing one domain share one URI:
#   https://${ROOT_DOMAIN}/realms/<realm>/broker/{google,facebook}/endpoint
# Register that URI (alongside the localhost one) on whichever app you use.
CLOUD_GOOGLE_CLIENT_ID=
CLOUD_GOOGLE_CLIENT_SECRET=
CLOUD_FACEBOOK_CLIENT_ID=
CLOUD_FACEBOOK_CLIENT_SECRET=

# Stripe: https://dashboard.stripe.com/test/apikeys
# The secret key is used by ecpay; the publishable key is served to the browser
# by ecfront at start-up. Both are needed for card payments to work.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# ── Cloud deployments (gcp/, and later azure/, aws/) ─────────────────────────

# GCP project to deploy into.
GCP_PROJECT=your-gcp-project-id

# The domain you own and will serve the platform on, no trailing dot.
# Subdomains sales./admin./dashboard. are derived from it automatically.
# Claim a free one at https://dash.domain.digitalplat.org if you need one.
# The same domain can be moved between clouds: destroy one, apply the next.
ROOT_DOMAIN=example.dpdns.org

# Registrar API token used to push the cloud's nameservers to the domain
# automatically (DigitalPlat: Dashboard -> API Keys -> Create API Key).
DOMAIN_API_KEY=

# The ONLY source IP allowed to reach the HTTPS ingress and the k8s control
# plane. Find yours with: curl https://api.ipify.org
ALLOWLIST_CIDR=203.0.113.10/32

# Email for Let's Encrypt certificate expiry notices.
LETSENCRYPT_EMAIL=your_email@example.com
